# ==============================================================================
# LAYA Website Environment Variables Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# Vite exposes variables prefixed with VITE_ to client-side code via import.meta.env.
# DO NOT store sensitive credentials, database passwords, or private keys here.
# ==============================================================================

# WordPress Contact API Base URL
# ------------------------------------------------------------------------------
# Configures axios baseURL for contact form submission in src/services/api.ts.
# Note: The client initiates requests with `api.post("/contact", payload)`.
#
# When connecting to the WordPress REST API plugin (docs/wordpress_contact_api_integration.php):
#   - The plugin registers endpoint: /wp-json/contact/v1/send
#   - If proxying via web server (recommended): Set VITE_WP_API_URL="" so requests hit
#     the same-origin `/contact` route, and configure IIS/Apache/Express to proxy
#     `/contact` -> `https://cms.laya.org.in/wp-json/contact/v1/send`.
#   - If connecting directly from browser to WordPress: Ensure the WordPress route
#     matches or set VITE_WP_API_URL to the base path prefix (e.g., https://cms.laya.org.in/wp-json).
#
# If left blank, client requests default to relative path `/contact`.
VITE_WP_API_URL=

# Node.js Express Server Configuration (Server runtime only, not bundled in client)
# ------------------------------------------------------------------------------
# The port on which server.js listens when running the Express production server.
# Managed hosting environments (such as Hostinger or Heroku) set this automatically.
# PORT=3000

